<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The engine's account: enough to search the catalog, hold and release items, and create and follow up leads.
         It is not an administrator. scripts/create_odoo_engine_user.py puts a user in this group. -->
    <record id="group_engine" model="res.groups">
        <field name="name">LeadGate Engine</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
        ]"/>
    </record>
</odoo>
