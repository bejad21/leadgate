# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=leadgate
ODOO_USER=admin
ODOO_PASSWORD=admin

# LLM API Keys (choose one)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Active domain adapter for the agent loop (valid values: cars, real_estate)
ACTIVE_DOMAIN=cars

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Supabase anon/public key (Project Settings -> API -- NOT the service_role key
# above). Used only by dashboard/.env.local (see README Setup step 8), copied
# here as a placeholder for completeness.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase direct DB password OR management-API access token (need only ONE of
# these two -- used once, by n8n/scripts/setup_supabase_table.py, to create the
# catalog_items table; the service_role key above cannot run DDL). See README
# Setup step 5 for where to get either one.
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/leadgate

# PostgreSQL (for Odoo)
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Kaggle (for downloading the cars/real-estate datasets in Tasks 1.1/1.2)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# n8n (self-hosted, Task 3.1)
GENERIC_TIMEZONE=Asia/Dubai
N8N_OWNER_EMAIL=admin@leadgate.local
N8N_OWNER_PASSWORD=your_n8n_owner_password_here

# n8n API key for the deploy/credential-setup scripts (generated from the n8n
# UI, Settings -> n8n API, after n8n's first-run owner setup -- see README
# Setup step 5). Not available until n8n is already running, so it can't be
# filled in ahead of time like the rest of this file.
N8N_API_KEY=your_n8n_api_key_here

# Alerts: a SECOND Telegram bot that only messages you when a lead arrives.
# Create it with @BotFather (name it e.g. "LeadGate Alerts"), send it /start from your
# own account, then get your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates   (look for "chat":{"id":...})
# Leave both empty to run without alerts.
TELEGRAM_ALERTS_BOT_TOKEN=your_alert_bot_token_here
TELEGRAM_ALERTS_CHAT_ID=your_chat_id_here
# Base URL used for the "Open in Odoo" link in an alert (defaults to ODOO_URL).
ODOO_PUBLIC_URL=http://localhost:8069

# Dashboard: leads and conversations are private. This is the staff login that
# n8n/scripts/create_dashboard_user.py creates in Supabase Auth.
DASHBOARD_LOGIN_EMAIL=you@example.com
DASHBOARD_LOGIN_PASSWORD=choose_a_long_password_here

# Secret used to hash Telegram chat ids before they are stored in Supabase. Any long
# random string (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Without it the engine will not mirror conversations to the dashboard.
CHAT_REF_SECRET=generate_a_long_random_string_here
