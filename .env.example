# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=leadgate
ODOO_USER=admin
ODOO_PASSWORD=admin

# LLM API Keys (choose one)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Active domain adapter for the agent loop (valid values: cars, real_estate)
ACTIVE_DOMAIN=cars

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/leadgate

# PostgreSQL (for Odoo)
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Kaggle (for downloading the cars/real-estate datasets in Tasks 1.1/1.2)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# n8n (self-hosted, Task 3.1)
GENERIC_TIMEZONE=Asia/Dubai
N8N_OWNER_EMAIL=admin@leadgate.local
N8N_OWNER_PASSWORD=your_n8n_owner_password_here
