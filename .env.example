# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# docs/SETUP.md explains where each value comes from.

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=leadgate
ODOO_USER=admin
ODOO_PASSWORD=admin
# Optional: seconds a call to Odoo may wait before it fails (default 30)
# ODOO_TIMEOUT_SECONDS=30

# LLM API keys (set at least one; with several set, OpenRouter is tried first, then Mistral, then NVIDIA)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# NVIDIA's hosted API (build.nvidia.com) has a free tier for development, so one key is enough to run the engine and the eval.
# Its free queue can take over a minute per call: set LLM_TIMEOUT_SECONDS=120 when you use it.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional: pin the NVIDIA model (default mistralai/mistral-large-4-1t-a52b).
# NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
# Optional: comma-separated OpenRouter model ids, tried in order (a retired or rate-limited model
# hands over to the next). Free models come and go; see https://openrouter.ai/api/v1/models
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nex-agi/nex-n2.5-pro:free
# Optional: pin the Mistral model (default mistral-small-latest, which Mistral moves). A dated id keeps
# an eval run on one model; the model that answered is in every trace record.
# MISTRAL_MODEL=mistral-small-2603
# Optional: what every model call sends. Temperature 0 (the default) suits tool calling. The seed
# is sent only when set; not every provider honours it.
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=800
# LLM_SEED=42
# Optional: seconds one model call may take before it fails (default 30, at most 600).
# LLM_TIMEOUT_SECONDS=30
# Optional: low | medium | high. Thinking models such as mistral-large-4 default to high and can spend the whole token budget thinking.
# LLM_REASONING_EFFORT=low
# Optional: dollars per million tokens, used to estimate cost when the provider does not report one.
# Leave unset (0) for free models.
# LLM_PRICE_PER_MTOK_INPUT=0
# LLM_PRICE_PER_MTOK_OUTPUT=0

# Customer-facing Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Which catalog the agent serves. Allowed values: cars, real_estate. Any other value stops the
# engine at startup.
ACTIVE_DOMAIN=cars

# Supabase: the dashboard's data AND the engine's own durable state (chat history, which chat a lead
# came from, handled update ids, rate limits). Without SUPABASE_URL and the service key the engine
# keeps all of that in memory and forgets it on restart.
# The project address, https://<ref>.supabase.co (a trailing /rest/v1 is accepted and removed).
SUPABASE_URL=your_supabase_url_here
# The service_role key. It bypasses row level security, so it stays on the server:
# the engine and the scripts use it, the browser never does.
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# The anon (public) key from Project Settings > API. Do not use the service_role key here.
# The dashboard reads it from dashboard/.env.local as VITE_SUPABASE_ANON_KEY
# (see docs/SETUP.md, step 9); it is listed here so all keys live in one place.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# To create the Supabase tables: the project's Postgres password (Project Settings > Database).
# The service_role key cannot run DDL, so scripts/apply_migrations.py connects to Postgres with this.
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# PostgreSQL (Odoo's own database)
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Kaggle (only for downloading the two datasets)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Odoo tells the engine when a catalog item's status changes (POST /webhook/odoo-status) and the
# engine updates the dashboard's row. The shared secret must be at least 16 characters and the same
# value on both sides: put it here, then run  python scripts/set_odoo_webhook_param.py  to give it to
# Odoo. Without it the route answers 503 and does nothing.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ODOO_WEBHOOK_SECRET=generate_a_long_random_string_here
# Only if the engine is not at http://engine:8000 on the Compose network (where Odoo reaches it):
# ODOO_STATUS_WEBHOOK_URL=http://engine:8000/webhook/odoo-status

# Lead alerts (optional). Use a SECOND Telegram bot so alerts never share a token or a
# chat with customers. Create it in @BotFather (for example "LeadGate Alerts"), open it
# and press Start (a bot can only message someone who has messaged it first), then read
# your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates    (look for "chat":{"id":...})
# Leave both empty to run without alerts.
TELEGRAM_ALERTS_BOT_TOKEN=your_alert_bot_token_here
TELEGRAM_ALERTS_CHAT_ID=your_chat_id_here
# The alert bot has its own webhook, so its buttons and replies can reach the engine. Any long
# random string works:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Register it with:  python -m engine.register_alert_webhook https://<your public address>
# Without a secret the engine refuses everything on that route.
TELEGRAM_ALERTS_WEBHOOK_SECRET=generate_a_long_random_string_here
# Address used for the "Open in Odoo" link in an alert. Telegram does not turn localhost
# into a link, so on a local setup the text shows but is not tappable. Use an address your
# phone can reach to make it work. Defaults to ODOO_URL.
ODOO_PUBLIC_URL=http://localhost:8069

# Who new leads are assigned to in Odoo (an Odoo login). Defaults to ODOO_USER.
# ODOO_SALESPERSON_LOGIN=admin
# Country code of your customers (digits only). A phone number the assistant records must be one
# the customer typed, or that number with this code in front. It also turns a local number a
# customer types (050 123 4567) into international form (+971501234567).
# DEFAULT_PHONE_COUNTRY_CODE=971

# Dashboard staff login for the Leads tab. scripts/create_dashboard_user.py creates it
# in Supabase Auth with a staff role; only that role can read leads and conversations.
DASHBOARD_LOGIN_EMAIL=you@example.com
DASHBOARD_LOGIN_PASSWORD=choose_a_long_password_here

# Secret for hashing Telegram chat ids before they are stored in Supabase. Any long random
# string works:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it the engine does not mirror conversations to the dashboard.
CHAT_REF_SECRET=generate_a_long_random_string_here

# Optional: set to 1 when running eval/run_eval.py. Lead and contact writes then get a fake
# id instead of reaching Odoo, so re-running the eval does not fill the CRM with leads.
# EVAL_RECORD_LEADS=1

# Optional: append one JSON line per customer turn (models, tokens, cost, timings, tool outcomes; never
# message text) to this file. The same line also goes to the `leadgate.trace` log.
# Summarise it with: python eval/trace_summary.py <file>
# In the Docker engine the file must be writable by its unprivileged user: use an absolute path
# such as /tmp/traces/turns.jsonl (a relative path lands in /app, which it cannot write).
# TRACE_FILE=./traces/turns.jsonl

# Optional: how much the engine logs. DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO).
# Logs are JSON, one object per line, and mask bot tokens, bearer tokens and API keys.
# LOG_LEVEL=INFO
