# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=leadgate
ODOO_USER=admin
ODOO_PASSWORD=admin

# LLM API Keys (choose one)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Active domain adapter for the agent loop (valid values: cars, real_estate)
ACTIVE_DOMAIN=cars

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Supabase anon/public key (Project Settings -> API -- NOT the service_role key
# above). Used only by dashboard/.env.local (see README Setup step 8), copied
# here as a placeholder for completeness.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase direct DB password OR management-API access token (need only ONE of
# these two -- used once, by n8n/scripts/setup_supabase_table.py, to create the
# catalog_items table; the service_role key above cannot run DDL). See README
# Setup step 5 for where to get either one.
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/leadgate

# PostgreSQL (for Odoo)
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Kaggle (for downloading the cars/real-estate datasets in Tasks 1.1/1.2)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# n8n (self-hosted, Task 3.1)
GENERIC_TIMEZONE=Asia/Dubai
N8N_OWNER_EMAIL=admin@leadgate.local
N8N_OWNER_PASSWORD=your_n8n_owner_password_here

# n8n API key for the deploy/credential-setup scripts (generated from the n8n
# UI, Settings -> n8n API, after n8n's first-run owner setup -- see README
# Setup step 5). Not available until n8n is already running, so it can't be
# filled in ahead of time like the rest of this file.
N8N_API_KEY=your_n8n_api_key_here
