# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# docs/SETUP.md explains where each value comes from.

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=leadgate
ODOO_USER=admin
ODOO_PASSWORD=admin

# LLM API keys (set one; if both are set OpenRouter is tried first and Mistral is the fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional: comma-separated OpenRouter model ids, tried in order (a retired or rate-limited model
# hands over to the next). Free models come and go; see https://openrouter.ai/api/v1/models
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nex-agi/nex-n2.5-pro:free

# Customer-facing Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Which catalog the agent serves (cars or real_estate)
ACTIVE_DOMAIN=cars

# Supabase
SUPABASE_URL=your_supabase_url_here
# The service_role key. It bypasses row level security, so it stays on the server:
# the engine and n8n use it, the browser never does.
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# The anon (public) key from Project Settings > API. Do not use the service_role key here.
# The dashboard reads it from dashboard/.env.local as VITE_SUPABASE_ANON_KEY
# (see docs/SETUP.md, step 9); it is listed here so all keys live in one place.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# To create the Supabase tables you need ONE of these two. The service_role key cannot
# run DDL, so n8n/scripts/setup_supabase_table.py uses whichever you provide, once for
# the catalog table and once for the leads and conversation tables.
#   SUPABASE_DB_PASSWORD: the project's Postgres password (Project Settings > Database)
#   SUPABASE_ACCESS_TOKEN: a personal access token (starts with sbp_)
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# MongoDB (audit log and conversation memory)
MONGODB_URI=mongodb://localhost:27017/leadgate

# PostgreSQL (Odoo's own database)
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Kaggle (only for downloading the two datasets)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# n8n (self-hosted)
GENERIC_TIMEZONE=Asia/Dubai
N8N_OWNER_EMAIL=admin@leadgate.local
N8N_OWNER_PASSWORD=your_n8n_owner_password_here

# Key for the n8n deploy and credential scripts. n8n has to be running before you can
# create it (Settings > n8n API), so it cannot be filled in ahead of time like the rest.
N8N_API_KEY=your_n8n_api_key_here
# Only needed if n8n is not at http://localhost:5678
# N8N_API_URL=http://localhost:5678

# Lead alerts (optional). Use a SECOND Telegram bot so alerts never share a token or a
# chat with customers. Create it in @BotFather (for example "LeadGate Alerts"), open it
# and press Start (a bot can only message someone who has messaged it first), then read
# your chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates    (look for "chat":{"id":...})
# Leave both empty to run without alerts.
TELEGRAM_ALERTS_BOT_TOKEN=your_alert_bot_token_here
TELEGRAM_ALERTS_CHAT_ID=your_chat_id_here
# The alert bot has its own webhook, so its buttons and replies can reach the engine. Any long
# random string works:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Register it with:  python -m engine.register_alert_webhook https://<your public address>
# Without a secret the engine refuses everything on that route.
TELEGRAM_ALERTS_WEBHOOK_SECRET=generate_a_long_random_string_here
# Address used for the "Open in Odoo" link in an alert. Telegram does not turn localhost
# into a link, so on a local setup the text shows but is not tappable. Use an address your
# phone can reach to make it work. Defaults to ODOO_URL.
ODOO_PUBLIC_URL=http://localhost:8069

# Who new leads are assigned to in Odoo (an Odoo login). Defaults to ODOO_USER.
# ODOO_SALESPERSON_LOGIN=admin
# Country code of your customers (digits only). A phone number the assistant records must be one
# the customer typed, or that number with this code in front. It also turns a local number a
# customer types (050 123 4567) into international form (+971501234567).
# DEFAULT_PHONE_COUNTRY_CODE=971
# Minutes an untouched lead waits before the owner gets one reminder. 0 turns it off.
# LEAD_REMINDER_MINUTES=30

# Dashboard staff login for the Leads tab. n8n/scripts/create_dashboard_user.py creates it
# in Supabase Auth with a staff role; only that role can read leads and conversations.
DASHBOARD_LOGIN_EMAIL=you@example.com
DASHBOARD_LOGIN_PASSWORD=choose_a_long_password_here

# Secret for hashing Telegram chat ids before they are stored in Supabase. Any long random
# string works:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it the engine does not mirror conversations to the dashboard.
CHAT_REF_SECRET=generate_a_long_random_string_here

# Optional: set to 1 when running eval/run_eval.py. Lead and contact writes then get a fake
# id instead of reaching Odoo, so re-running the eval does not fill the CRM with leads.
# EVAL_RECORD_LEADS=1
