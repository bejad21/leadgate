: 37940.0, "attributes": "{\"make\": \"Tesla\", \"model\": \"Model Y\", \"year\": \"2024\", \"mileage\": \"25025\", \"condition\": \"Used\", \"location\": \"Eminence, KY\"}"}, {"id": 54, "name": "2025 Tesla Model 3", "price": 36460.0, "attributes": "{\"make\": \"Tesla\", \"model\": \"Model 3\", \"year\": \"2025\", \"mileage\": \"9655\", \"condition\": \"Used\", \"location\": \"Bedford, OH\"}"}, {"id": 56, "name": "2022 Tesla Model Y", "price": 32210.0, "attributes": "{\"make\": \"Tesla\", \"model\": \"Model Y\", \"year\": \"2022\", \"mileage\": \"44809\", \"condition\": \"Used\", \"location\": \"Cincinnati, OH\"}"}], "count": 3}]}}
