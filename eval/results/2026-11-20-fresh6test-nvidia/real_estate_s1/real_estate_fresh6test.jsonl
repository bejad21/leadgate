d/3ba residential - Burlington, New Jersey", "price": 250000.0, "attributes": "{\"property_type\": \"residential\", \"bed\": \"3\", \"bath\": \"3\", \"acre_lot\": \"0.11\", \"city\": \"Burlington\", \"state\": \"New Jersey\", \"zip_code\": \"8016\", \"house_size\": \"1636\"}"}], "count": 2}]}}
