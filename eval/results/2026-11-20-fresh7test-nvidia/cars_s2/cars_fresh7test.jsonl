": 31, "name": "2018 Nissan Titan", "price": 28905.0, "attributes": "{\"make\": \"Nissan\", \"model\": \"Titan\", \"year\": \"2018\", \"mileage\": \"59050\", \"condition\": \"Used\", \"location\": \"Shell Rock, IA\"}"}, {"id": 180, "name": "2022 Nissan Frontier", "price": 33270.0, "attributes": "{\"make\": \"Nissan\", \"model\": \"Frontier\", \"year\": \"2022\", \"mileage\": \"11432\", \"condition\": \"Certified\", \"location\": \"Tampa, FL\"}"}, {"id": 184, "name": "2025 Nissan Kicks", "price": 20515.0, "attributes": "{\"make\": \"Nissan\", \"model\": \"Kicks\", \"year\": \"2025\", \"mileage\": \"2228\", \"condition\": \"Certified\", \"location\": \"Roanoke, VA\"}"}, {"id": 223, "name": "2026 Nissan Kicks", "price": 25730.0, "attributes": "{\"make\": \"Nissan\", \"model\": \"Kicks\", \"year\": \"2026\", \"mileage\": \"212\", \"condition\": \"Used\", \"location\": \"Phoenix, AZ\"}"}, {"id": 255, "name": "2026 Nissan Rogue", "price": 27980.0, "attributes": "{\"make\": \"Nissan\", \"model\": \"Rogue\", \"year\": \"2026\", \"mileage\": \"2071\", \"condition\": \"Certified\", \"location\": \"Ocala, FL\"}"}], "count": 10}]}}
