boro, GA\"}"}, {"id": 76, "name": "2021 Jeep Grand Cherokee", "price": 13890.0, "attributes": "{\"make\": \"Jeep\", \"model\": \"Grand Cherokee\", \"year\": \"2021\", \"mileage\": \"126827\", \"condition\": \"Used\", \"location\": \"Buckner, KY\"}"}, {"id": 89, "name": "2014 Acura MDX", "price": 14740.0, "attributes": "{\"make\": \"Acura\", \"model\": \"MDX\", \"year\": \"2014\", \"mileage\": \"105320\", \"condition\": \"Used\", \"location\": \"Columbus, OH\"}"}, {"id": 138, "name": "2020 Volkswagen Jetta", "price": 15755.0, "attributes": "{\"make\": \"Volkswagen\", \"model\": \"Jetta\", \"year\": \"2020\", \"mileage\": \"68154\", \"condition\": \"Used\", \"location\": \"Jamestown, NY\"}"}], "count": 11}]}}
