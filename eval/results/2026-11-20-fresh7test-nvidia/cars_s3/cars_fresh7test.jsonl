ertified", "make": "Toyota", "model": "RAV4"}, "id": "98b1c3621"}], "tool_results": [{"matches": [{"id": 39, "name": "2025 Toyota RAV4", "price": 34905.0, "attributes": "{\"make\": \"Toyota\", \"model\": \"RAV4\", \"year\": \"2025\", \"mileage\": \"4946\", \"condition\": \"Certified\", \"location\": \"Louisville, KY\"}"}, {"id": 155, "name": "2024 Toyota RAV4", "price": 35820.0, "attributes": "{\"make\": \"Toyota\", \"model\": \"RAV4\", \"year\": \"2024\", \"mileage\": \"65281\", \"condition\": \"Certified\", \"location\": \"Louisville, KY\"}"}, {"id": 162, "name": "2025 Toyota RAV4", "price": 37550.0, "attributes": "{\"make\": \"Toyota\", \"model\": \"RAV4\", \"year\": \"2025\", \"mileage\": \"30802\", \"condition\": \"Certified\", \"location\": \"Louisville, KY\"}"}], "count": 3}]}}
